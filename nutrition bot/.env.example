[TEMPLATE]
# ============================================================
#  IBM Watsonx.ai Nutrition Agent — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# ------ IBM Watsonx.ai Credentials ------
IBM_API_KEY=your_ibm_cloud_api_key_here
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com
IBM_PROJECT_ID=your_watsonx_project_id_here

# ------ Model Selection ------
# Recommended IBM Granite models:
#   ibm/granite-3-3-8b-instruct      (fast, great for chat)
#   ibm/granite-3-2-8b-instruct      (balanced)
#   ibm/granite-13b-instruct-v2      (larger, more capable)
WATSONX_MODEL_ID=meta-llama/llama-3-3-70b-instruct

# ------ Flask App Config ------
FLASK_SECRET_KEY=generate-a-random-32-char-string-here
FLASK_DEBUG=False
# HerGuardian AI's Node backend uses port 5000, so the nutrition
# service defaults to 5001 to avoid a conflict.
FLASK_PORT=5001

# ------ CORS (HerGuardian frontend origins) ------
# Comma-separated extra origins on top of the localhost dev defaults
# (http://localhost:5173, http://localhost:5174, http://localhost:5175).
CORS_ORIGINS=https://your-herguardian-frontend.example.com
