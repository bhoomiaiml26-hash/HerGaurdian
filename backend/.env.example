PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/herguardian?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret
GEMINI_API_KEY=your_gemini_api_key_here
FRONTEND_URL=http://localhost:5173

# Opportunity feeds (all optional; each source is skipped if credentials are missing)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
RAPIDAPI_KEY=
CRON_SECRET=

# Gmail SMTP — use a Google App Password, not your real Gmail password.
# Generate one at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
# SMTP_FROM must match SMTP_USER exactly when using Gmail
SMTP_FROM="HerGuardian AI <your_gmail_address@gmail.com>"
FROM_NAME=HerGuardian AI
FROM_EMAIL=your_gmail_address@gmail.com
